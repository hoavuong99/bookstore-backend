{
  "info": {
    "_postman_id": "e57faf30-f9e8-45e7-b52f-0e47b33f0678",
    "name": "Bookstore Backend - Dashboard E2E Scenario",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "E2E flow: login, create books, add to cart, checkout, set DELIVERED, verify dashboard analytics for chart rendering."
  },
  "item": [
    {
      "name": "1) Login Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "const res = pm.response.json();",
              "pm.expect(res.success).to.eql(true);",
              "pm.collectionVariables.set('adminToken', res.data.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "2) Create Low-Stock Book",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
              "const res = pm.response.json();",
              "pm.expect(res.success).to.eql(true);",
              "pm.collectionVariables.set('bookLowId', String(res.data.id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"E2E Low Stock {{$timestamp}}\",\n  \"isbn\": \"E2E-LOW-{{$timestamp}}\",\n  \"price\": 120000,\n  \"stockQuantity\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        }
      },
      "response": []
    },
