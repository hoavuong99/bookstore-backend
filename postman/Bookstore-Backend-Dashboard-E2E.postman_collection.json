    {
      "name": "5) Add Low-Stock Book To Cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "const res = pm.response.json();",
              "pm.expect(res.success).to.eql(true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{customerToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookId\": {{bookLowId}},\n  \"quantity\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/cart/items",
          "host": ["{{baseUrl}}"],
          "path": ["cart", "items"]
        }
      },
      "response": []
    },
    {
      "name": "6) Add Normal Book To Cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "const res = pm.response.json();",
              "pm.expect(res.success).to.eql(true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{customerToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookId\": {{bookNormalId}},\n  \"quantity\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/cart/items",
          "host": ["{{baseUrl}}"],
          "path": ["cart", "items"]
        }
      },
      "response": []
    },
    {
      "name": "7) Checkout",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
              "const res = pm.response.json();",
              "pm.expect(res.success).to.eql(true);",
              "pm.collectionVariables.set('orderId', String(res.data.orderId));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{customerToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipientName\": \"{{recipientName}}\",\n  \"recipientPhone\": \"{{recipientPhone}}\",\n  \"shippingAddress\": \"{{shippingAddress}}\",\n  \"paymentMethod\": \"COD\",\n  \"couponCode\": null\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/orders/checkout",
          "host": ["{{baseUrl}}"],
          "path": ["orders", "checkout"]
        }
      },
      "response": []
    },
    {
      "name": "8) Admin Update Order Status -> DELIVERED",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "const res = pm.response.json();",
              "pm.expect(res.success).to.eql(true);",
              "pm.expect(res.data.orderStatus).to.eql('DELIVERED');"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"DELIVERED\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/orders/admin/{{orderId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["orders", "admin", "{{orderId}}", "status"]
        }
      },
      "response": []
    },
    {
      "name": "9) Verify Dashboard Summary (for chart)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "const res = pm.response.json();",
              "pm.expect(res.success).to.eql(true);",
              "pm.expect(res.data.totalRevenue).to.not.eql(null);",
              "pm.expect(Number(res.data.totalRevenue)).to.be.greaterThan(0);",
              "pm.expect(Number(res.data.totalBooks)).to.be.greaterThan(0);",
              "pm.expect(Number(res.data.totalStockQuantity)).to.be.greaterThan(0);",
              "pm.expect(Array.isArray(res.data.lowStockBooks)).to.eql(true);",
              "const lowBookId = Number(pm.collectionVariables.get('bookLowId'));",
              "const exists = res.data.lowStockBooks.some(b => Number(b.bookId) === lowBookId);",
              "pm.test('Low-stock seeded book appears in alert list', function () { pm.expect(exists).to.eql(true); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/dashboard/summary",
          "host": ["{{baseUrl}}"],
          "path": ["dashboard", "summary"]
        }
      },
      "response": []
    }
  ],
