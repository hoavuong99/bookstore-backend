          "raw": "{\n  \"title\": \"E2E Normal Stock {{$timestamp}}\",\n  \"isbn\": \"E2E-NORMAL-{{$timestamp}}\",\n  \"price\": 200000,\n  \"stockQuantity\": 50\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        }
      },
      "response": []
